FROM eclipse-temurin:25-jdk AS java
FROM node:22-bookworm-slim AS build
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pil python3-fonttools && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit
COPY tsconfig.server.json ./
COPY server ./server
COPY server-plugin ./server-plugin
COPY experiments/minecraft-26 ./experiments/minecraft-26
COPY vendor/clients/stable-galmuri.epw ./vendor/clients/stable-galmuri.epw
COPY vendor/fonts/galmuri ./vendor/fonts/galmuri
COPY public/game/portal-bridge.js ./public/game/portal-bridge.js
COPY experiments/minecraft-26/cache/ ./work/minecraft-26/runtime/cache/
RUN npm run build:server && PREVIEW_BUILD=true PREVIEW_CLOUD=true node experiments/minecraft-26/prepare.mjs \
    && node experiments/minecraft-26/build-preview-plugin.mjs \
    && node experiments/minecraft-26/build-bridge.mjs && npm prune --omit=dev

FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
ENV NODE_ENV=production MC_VERSION=26.2 SERVE_CLIENT=false DATA_DIR=/data MC_EULA=true MC_MEMORY_MB=2048 PORT=3000
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/experiments ./experiments
COPY --from=build /app/work ./work
COPY public/assets/skins ./public/assets/skins
EXPOSE 3000
CMD ["node", "dist/server/index.js"]
