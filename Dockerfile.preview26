FROM eclipse-temurin:25-jdk AS java
FROM node:22-bookworm-slim AS build
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit
COPY tsconfig*.json vite.config.* index.html ./
COPY src ./src
COPY public ./public
COPY vendor ./vendor
COPY scripts ./scripts
COPY server-plugin ./server-plugin
COPY server ./server
COPY experiments/minecraft-26 ./experiments/minecraft-26
COPY experiments/minecraft-26/cache/ ./work/minecraft-26/runtime/cache/
RUN npm run build:client && npm run build:server \
    && PREVIEW_BUILD=true PREVIEW_CLOUD=true node experiments/minecraft-26/prepare.mjs \
    && node experiments/minecraft-26/build-preview-plugin.mjs \
    && node experiments/minecraft-26/build-bridge.mjs && npm prune --omit=dev

FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
ENV NODE_ENV=production PREVIEW_CLOUD=true PREVIEW_DATA=/data DATA_DIR=/data MC_MEMORY_MB=2048 MC_EULA=true PORT=8080
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/public ./public
COPY --from=build /app/experiments ./experiments
COPY --from=build /app/work ./work
EXPOSE 8080
CMD ["node", "experiments/minecraft-26/preview-entry.mjs"]
